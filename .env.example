# Plantilla de variables de entorno. Copiar a .env y rellenar.
# El .env real NUNCA se sube al repositorio (está en .gitignore).
#
# En local, spring-dotenv lee este fichero al arrancar y resuelve las ${...}
# de application.properties. En producción no existe: docker-compose inyecta
# las variables al contenedor desde los secrets de GitHub Actions.

# Puerto del servidor (si se omite, 5000)
PORT=5000

# Clave de firma de los JWT (HMAC-SHA256)
JWT_SECRET=

# MySQL en Aiven. Formato JDBC, con SSL exigido por Aiven.
# jdbc:mysql://HOST:PUERTO/BASEDATOS?useSSL=true&requireSSL=true&verifyServerCertificate=false&serverTimezone=UTC
DB_URL=
DB_USER=
DB_PASSWORD=

# Microservicio de IA (se autentica con la cabecera x-api-key)
# En local: http://localhost:8000
# En el VPS: http://fp_gpt:8000 — nombre del contenedor en la red Docker
IA_SERVICE_URL=
IA_SERVICE_API_KEY=
